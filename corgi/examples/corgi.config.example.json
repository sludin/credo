{
  "includes": ["../vars.config.json"],

  "vars": {
    "nodeName": "corgi-01"
  },

  "nodeId":      "${nodeName}",
  "commonName":  "${nodeName}.${vigilDomain}",
  "identityUri": "${identityPrefix}/node/${nodeName}",
  "shepherdUrl": "https://shepherd.${vigilDomain}:7010",

  "certStoreDir": "${corgiRoot}/store",

  "filePolicy": {
    "owner": "root",
    "group": "ssl-cert"
  },

  "tls": {
    "certPath": "${corgiStore}/${nodeName}.${vigilDomain}/fullchain.pem",
    "keyPath":  "${corgiStore}/${nodeName}.${vigilDomain}/privkey.pem"
  },

  "mtls": {
    "certPath": "${corgiStore}/${nodeName}.${vigilDomain}/fullchain.pem",
    "keyPath":  "${corgiStore}/${nodeName}.${vigilDomain}/privkey.pem",
    "caPath":   "${caTrustPath}"
  },

  "mtlsPort": 7001,
  "bind":     "0.0.0.0",

  "auth": {
    "mode":         "mtls",
    "identityOnly": false
  },

  "rbacIdentities": [
    {
      "uri":  "${identityPrefix}/service/shepherd",
      "role": "admin",
      "name": "shepherd"
    }
  ],

  "shepherdSync": {
    "enabled":              true,
    "intervalSeconds":      60,
    "staleWarningSeconds":  300,
    "assignmentsCachePath": "./corgi.assignments.cache.json"
  },

  "_httpChallenge": "Uncomment to enable HTTP-01 ACME challenge listener",
  "_httpChallengeBlock": {
    "enabled": true,
    "port":    7080,
    "bind":    "0.0.0.0"
  },

  "flock": [
    {
      "_comment": "Example: nginx TLS cert managed by Shepherd",
      "name":          "api.${vigilDomain}",
      "path":          "/etc/ssl/certs/api.${vigilDomain}.pem",
      "keyPath":       "/etc/ssl/private/api.${vigilDomain}.key",
      "fullchainPath": "/etc/ssl/certs/api.${vigilDomain}.fullchain.pem",
      "hooks":         ["nginx"],
      "monitor":       true,
      "certMode":      "0644",
      "keyMode":       "0600"
    }
  ],

  "_hookTypes": "Object-shaped hooks require an explicit \"type\": \"exec\" (shell command with typed args) or \"type\": \"signal\" (credoSignal — sends a signal directly to a PID file, no subprocess/shell). The array shorthand below needs no type; it's always the simple shell-command case.",
  "serviceHooks": {
    "nginx":  ["systemctl", "reload", "nginx"],
    "caddy":  ["caddy", "reload", "--config", "/etc/caddy/Caddyfile", "--force"],
    "apache": ["systemctl", "reload", "apache2"],
    "docker-nginx": {
      "type": "exec",
      "exec": ["docker", "exec", "-t", "{container}", "nginx", "-s", "reload"],
      "args": { "container": { "type": "container-name" } }
    },
    "corgi-self-reload": { "type": "signal", "pidFile": "corgi.pid" }
  },

  "defaultHooks": [],

  "logLevel": "info",

  "_logging": "Opt-in rotating log file + live tail for the /logs endpoint; omit entirely for stdout-only (current behavior)",
  "_hookOutput": "A hook that exits non-zero always logs its stdout/stderr at ERROR. Set this true to also log a successful hook's stdout/stderr at INFO (default false, since successful output is usually just noise).",
  "logging": {
    "enabled": false,
    "dir": "logs",
    "rotateOn": { "sizeMb": 100, "keepFiles": 12 },
    "alsoStdout": true,
    "hookOutput": false
  }
}
